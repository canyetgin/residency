echo "🛡️ [Pipeline] Running project-wide TypeScript type-check..."

if ! pnpm type-check; then
  echo ""
  echo "❌ [ERROR] TypeScript compilation or missing import errors found!"
  echo "💡 Run 'pnpm type-check' locally to inspect and fix the broken files."
  echo "⚠️ Push aborted. Invalid code prevented from reaching remote repository."
  echo ""
  exit 1
fi